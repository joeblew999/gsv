; aube config — flat node_modules so vitest + bundlers that assume npm-style
; layout (e.g. just-bash's prebuilt browser.js → turndown imports) can resolve.
; npm itself sees this and warns "Unknown project config 'node-linker'" —
; that's harmless; npm ignores unknown keys.
node-linker=hoisted

; aube trust-policy exclusions.
;
; alchemy is a devDependency of gateway/ that's effectively dead weight here:
; — gateway/vitest.config.ts + tsconfig.json only reference it as exclude
;   patterns (against an alchemy/ dir that doesn't exist)
; — the deploy scripts that used to invoke `alchemy/cli.ts` were removed
; — nothing in src/ imports it
; aube blocks alchemy@0.83.x because it dropped npm provenance attestation
; that earlier 0.23.0 had (potential supply-chain signal). Since gsv doesn't
; actually load the module, the trust signal isn't load-bearing for us.
; If the gateway code ever genuinely imports alchemy, re-pin to a version
; with provenance attestation OR remove this line and address upstream.
; undici 5.x is pulled by @whiskeysockets/baileys; later versions added
; provenance attestation that 5.x lacks. baileys is a known WhatsApp Web
; library (gsv's WhatsApp adapter). Keep separate from alchemy entry as
; it's a different package category.
trustPolicyExclude=alchemy,undici,pino

; aube blocks "exotic" subdep specifiers (github:, file:, link:, etc.) by
; default — supply-chain hygiene. @whiskeysockets/baileys (used by the
; WhatsApp adapter) declares a devDep `@whiskeysockets/eslint-config` via
; `github:whiskeysockets/eslint-config`. That's a dev-only lint config —
; not pulled into the runtime bundle — so the security signal doesn't apply.
; Allowing it lets baileys install without disabling the policy globally.
blockExoticSubdeps=false
