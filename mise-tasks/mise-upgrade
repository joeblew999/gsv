#!/usr/bin/env nu
#MISE description="Bump pinned tool versions in mise.toml via `mise upgrade --bump`. Idempotent — exit 0 with no diff when nothing's stale."

# Same task drives both local upgrades (`mise run mise-upgrade`) and the
# scheduled CI workflow (.github/workflows/mise-upgrade.yml). Single source
# of truth — if you can run it locally, CI runs the same thing.

const SCRIPT_PATH = (path self)
const REPO_ROOT = ($SCRIPT_PATH | path dirname | path dirname)

def main [
  --dry-run          # show what would change without writing
] {
  cd $REPO_ROOT

  let before = (open --raw mise.toml)

  # --local restricts to this project's mise.toml — without it mise also
  # bumps tools from the global ~/.config/mise/config.toml (your other
  # projects' tools leak in: ruby, java, http:ifc-lite-server, etc.)
  if $dry_run {
    print "→ mise upgrade --bump --local --dry-run"
    ^mise upgrade --bump --local --dry-run
    return
  }

  print "→ mise upgrade --bump --local"
  ^mise upgrade --bump --local

  let after = (open --raw mise.toml)
  if $before == $after {
    print "✓ nothing to upgrade — mise.toml unchanged"
    return
  }

  print ""
  print "✓ mise.toml bumped:"
  ^git --no-pager diff -- mise.toml
}
