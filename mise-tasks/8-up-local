#!/usr/bin/env nu
#MISE description="Step 8 — start the local dev-stack daemon via pitchfork (wrangler dev on :8787)"
#MISE depends=["2-build-web", "3-build-rust"]

# Pre-builds web and rust so wrangler dev's parallel [build] hooks find fresh
# artefacts and short-circuit, rather than racing on cargo's cache lock.

def main [] {
  ^pitchfork start dev-stack
}
