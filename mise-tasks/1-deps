#!/usr/bin/env nu
#MISE description="Step 1 — install JS deps via aube (workspace + adapters + ripgit)"

# Aube is a fast Node package manager (drop-in npm replacement). Reads existing
# package-lock.json in place. ~2x faster than npm on cold install.
#
# Lifecycle-script approvals live in package.json under `aube.allowBuilds` —
# committed, so every contributor + CI gets the same set without prompts.
# Currently approved: esbuild, workerd, sharp, protobufjs, core-js-pure,
# @mongodb-js/zstd. node-liblzma is denied (gyp build fails; transitive,
# not needed at runtime).
#
# Upstream's bash equivalent (scripts/setup-deps.sh) stays untouched as a
# fallback if anyone wants pure npm.

const SCRIPT_PATH = (path self)
const REPO_ROOT = ($SCRIPT_PATH | path dirname | path dirname)

def main [] {
  print "→ workspace install via aube..."
  cd $REPO_ROOT
  ^aube install

  print ""
  print "→ adapter installs..."
  # Forward-slash glob pattern that works on Windows. We can't use
  # `path join` here because nu's path join uses the platform separator
  # (backslash on Windows), which re-introduces the very characters
  # nu's glob parser rejects. String interpolation + a final
  # backslash→forward-slash sweep handles both OSes.
  let adapters_glob = ($"($REPO_ROOT)/adapters/*" | str replace --all '\' '/')
  glob $adapters_glob
    | where { |p| ($p | path join package.json | path exists) }
    | each { |p|
        print $"  ($p | path basename)"
        ^aube ci -C $p
      }

  # whatsapp uses patch-package via npm postinstall. Approve its build.
  let wa = $"($REPO_ROOT)/adapters/whatsapp"
  if ($wa | path exists) {
    cd $wa
    do { ^aube approve-builds --all } | complete | ignore
    ^aube install -C $wa
  }

  print ""
  print "→ ripgit install via aube..."
  ^aube ci -C $"($REPO_ROOT)/ripgit"

  print ""
  print "✓ all JS deps installed via aube"
}
