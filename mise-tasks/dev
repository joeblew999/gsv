#!/usr/bin/env nu
#MISE description="Start wrangler dev for the multi-worker stack (foreground; replaces bash ./scripts/dev-stack.sh)"

const SCRIPT_PATH = (path self)
const REPO_ROOT = ($SCRIPT_PATH | path dirname | path dirname)

def main [] {
  let state = $"($REPO_ROOT)/.wrangler/dev-state/v3"
  [
    "do/ripgit-Repository"
    "do/gsv-Kernel"
    "do/gsv-Process"
    "do/gsv-channel-whatsapp-WhatsAppAccount"
  ] | each { |d| mkdir $"($state)/($d)" }

  cd $"($REPO_ROOT)/ripgit"
  ^npm exec -- wrangler dev -c ../gateway/wrangler.jsonc -c ../assembler/wrangler.toml -c ../adapters/whatsapp/wrangler.jsonc -c wrangler.toml --ip 0.0.0.0 --persist-to ../.wrangler/dev-state
}
