#!/usr/bin/env nu
#MISE description="Step 10 — start the device daemon (requires onboarded gateway + node.token in gsv local config)"
#MISE depends=["4-build-cli"]

const SCRIPT_PATH = (path self)
const REPO_ROOT = ($SCRIPT_PATH | path dirname | path dirname)

def main [] {
  let gsv = $"($REPO_ROOT)/cli/target/release/gsv"

  # Sanity-check: the daemon needs gateway.url + node.id + node.token set in
  # the local gsv config. Tell the user how to do it if missing.
  let token = (try { ^$gsv config --local get node.token | str trim } catch { "" })
  if ($token | is-empty) {
    print --stderr "✗ node.token not set in local gsv config."
    print --stderr ""
    print --stderr "Issue a token + save it first:"
    print --stderr "  gsv auth token create --kind node --device macbook --label macbook"
    print --stderr "  gsv config --local set node.token <token-from-above>"
    print --stderr "  gsv config --local set node.id macbook"
    print --stderr "  gsv config --local set gateway.url wss://gsv.<account>.workers.dev/ws  # or ws://localhost:8787/ws"
    exit 1
  }

  ^pitchfork start device
}
