#!/usr/bin/env nu
#MISE description="Step 9 — onboard the LOCAL gateway non-interactively (idempotent; password auto-generated to fnox)"
#MISE depends=["4-build-cli", "8-up-local"]

const SCRIPT_PATH = (path self)
const REPO_ROOT = ($SCRIPT_PATH | path dirname | path dirname)

def ensure-password [] {
  let existing = (try { ^fnox get GSV_PASSWORD | str trim } catch { "" })
  if ($existing | is-not-empty) {
    return $existing
  }
  let pw = (random chars --length 32)
  print --stderr "→ no GSV_PASSWORD in fnox; generating one..."
  $pw | ^fnox set --provider keychain GSV_PASSWORD
  print --stderr "✓ saved GSV_PASSWORD to fnox keychain"
  $pw
}

def main [] {
  let pw = (ensure-password)
  let gsv = $"($REPO_ROOT)/cli/target/release/gsv"
  if not ($gsv | path exists) {
    print --stderr "✗ gsv binary not found — run `mise run 4-build-cli`"
    exit 1
  }

  # Wait for local gateway to respond before trying to onboard.
  mut waited = 0
  loop {
    let ok = (try { ^curl -fsS -o /dev/null http://localhost:8787/; true } catch { false })
    if $ok { break }
    if $waited >= 60 {
      print --stderr "✗ local gateway never came up at http://localhost:8787"
      exit 1
    }
    sleep 2sec
    $waited = $waited + 2
  }

  let result = (do { ^$gsv --url ws://localhost:8787/ws auth setup --username joe --new-password $pw --node-id macbook --node-label macbook } | complete)

  if $result.exit_code == 0 {
    print "✓ local onboarded"
  } else if (($result.stderr | default "") | str contains "setup mode") {
    print "✓ local already onboarded — skipping"
  } else {
    print --stderr "✗ local onboard failed:"
    print --stderr ($result.stderr | default $result.stdout)
    exit 1
  }
}
