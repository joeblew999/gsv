#!/usr/bin/env nu
#MISE description="Step 5 — build local Cloudflare deploy bundles (5 workers → release/local/*.tar.gz)"
#MISE depends=["2-build-web", "3-build-rust"]

# Reimplements scripts/build-cloudflare-bundles.sh in nu. Sequential wrangler
# --dry-run for each component, then per-component manifest.json (via to json)
# + tar.gz tarballs + sha256 checksums. Sequential — sidesteps cargo cache
# contention.

const SCRIPT_PATH = (path self)
const REPO_ROOT = ($SCRIPT_PATH | path dirname | path dirname)

const COMPONENTS = [
  {
    name: "assembler"
    work_dir: ".",
    npm_workspace: "assembler",
    config_src: "assembler/wrangler.toml",
    config_dst: "wrangler.toml",
    has_assets: false
    has_source_map: false
  }
  {
    name: "gateway",
    work_dir: "gateway",
    npm_workspace: "",
    config_src: "gateway/wrangler.jsonc",
    config_dst: "wrangler.jsonc",
    has_assets: true,
    has_source_map: true
  }
  {
    name: "ripgit",
    work_dir: "ripgit",
    npm_workspace: "",
    config_src: "ripgit/wrangler.toml",
    config_dst: "wrangler.toml",
    has_assets: false,
    has_source_map: false
  }
  {
    name: "channel-whatsapp",
    work_dir: "adapters/whatsapp",
    npm_workspace: "",
    config_src: "adapters/whatsapp/wrangler.jsonc",
    config_dst: "wrangler.jsonc",
    has_assets: false,
    has_source_map: true
  }
  {
    name: "channel-discord",
    work_dir: "adapters/discord",
    npm_workspace: "",
    config_src: "adapters/discord/wrangler.jsonc",
    config_dst: "wrangler.jsonc",
    has_assets: false,
    has_source_map: true
  }
]

def main [out_dir?: string] {
  let dist = $"($REPO_ROOT)/dist/cloudflare"
  let out = ($out_dir | default $"($REPO_ROOT)/release/local")

  $env.COPYFILE_DISABLE = "1"
  $env.COPY_EXTENDED_ATTRIBUTES_DISABLE = "1"

  print "==> Bundling workers (sequential)"
  rm -rf $dist
  mkdir $dist
  for c in $COMPONENTS {
    let comp_dist = $"($dist)/($c.name)/worker"
    mkdir $comp_dist
    cd $"($REPO_ROOT)/($c.work_dir)"
    if ($c.npm_workspace | is-not-empty) {
      ^npm exec --workspace $c.npm_workspace -- wrangler deploy --dry-run --config $"($REPO_ROOT)/($c.config_src)" --outdir $comp_dist
    } else {
      ^npm exec --workspaces=false -- wrangler deploy --dry-run --outdir $comp_dist
    }
  }

  print "==> Writing manifests"
  for c in $COMPONENTS {
    let manifest_dir = $"($dist)/($c.name)"
    let entry = "worker/index.js"
    mut manifest = {component: $c.name, worker: {entrypoint: $entry, wranglerConfig: $c.config_dst}}
    if $c.has_source_map {
      $manifest.worker = ($manifest.worker | upsert sourceMap $"($entry).map")
    }
    if $c.has_assets {
      $manifest = ($manifest | upsert assetsDir "assets")
    }
    $manifest | to json --indent 2 | save -f $"($manifest_dir)/manifest.json"
    cp $"($REPO_ROOT)/($c.config_src)" $"($manifest_dir)/($c.config_dst)"
  }

  # Gateway needs the built web SPA bundled as assets/
  cp -r $"($REPO_ROOT)/web/dist" $"($dist)/gateway/assets"

  print "==> Stripping macOS metadata"
  glob $"($dist)/**/{._*,.DS_Store}"
    | each { |f| rm -f $f }

  print "==> Tarballing"
  mkdir $out
  glob $"($out)/gsv-cloudflare-*.tar.gz" | each { |f| rm -f $f }
  rm -f $"($out)/cloudflare-checksums.txt"
  for c in $COMPONENTS {
    ^tar -C $dist -czf $"($out)/gsv-cloudflare-($c.name).tar.gz" $c.name
  }

  print "==> Checksums"
  let lines = (
    glob $"($out)/gsv-cloudflare-*.tar.gz"
    | each { |f|
        let name = ($f | path basename)
        let hash = (open --raw $f | hash sha256)
        $"($hash)  ($name)"
      }
  )
  $lines | str join "\n" | save -f $"($out)/cloudflare-checksums.txt"

  print ""
  print $"✓ bundles ready in ($out):"
  ls $"($out)/gsv-cloudflare-*.tar.gz" | each { |f| print $"  ($f.name | path basename) (($f.size))" }
}
