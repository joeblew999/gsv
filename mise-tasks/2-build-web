#!/usr/bin/env nu
#MISE description="Step 2 — build the web shell into web/dist (required by gateway worker)"
#MISE depends=["1-deps"]

const SCRIPT_PATH = (path self)
const REPO_ROOT = ($SCRIPT_PATH | path dirname | path dirname)

def main [] {
  cd $REPO_ROOT
  ^npm run build --prefix web
  print "✓ web/dist built"
}
