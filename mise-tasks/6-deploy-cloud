#!/usr/bin/env nu
#MISE description="Step 6 — deploy GSV infra to Cloudflare via the gsv CLI (uses fnox-backed CF token)"
#MISE depends=["cf:token-check", "4-build-cli", "5-build-bundles"]

const SCRIPT_PATH = (path self)
const REPO_ROOT = ($SCRIPT_PATH | path dirname | path dirname)

def main [] {
  let token = (^fnox get CLOUDFLARE_API_TOKEN | str trim)
  let account = (^fnox get CLOUDFLARE_ACCOUNT_ID | str trim)
  let gsv = $"($REPO_ROOT)/cli/target/release/gsv"
  if not ($gsv | path exists) {
    print --stderr "✗ gsv binary not found — run `mise run 4-build-cli` first"
    exit 1
  }

  with-env {CF_API_TOKEN: $token, CF_ACCOUNT_ID: $account} {
    cd $REPO_ROOT
    ^$gsv infra deploy --all --bundle-dir ./release/local
  }
}
