#!/usr/bin/env nu
#MISE description="End-to-end smoke: send a one-shot chat to the configured agent, expect a non-empty reply"

const SCRIPT_PATH = (path self)
const REPO_ROOT = ($SCRIPT_PATH | path dirname | path dirname)

def main [] {
  let gsv = $"($REPO_ROOT)/cli/target/release/gsv"
  let result = (do { ^$gsv chat "Reply with one word: ok" } | complete)
  let body = ($result.stdout | default "")
  print $body
  let lines = ($body | lines | where { |l| ($l | str trim | is-not-empty) and not ($l | str starts-with "Connecting") })
  if ($lines | length) > 0 and $result.exit_code == 0 {
    print "✓ chat round-trip working"
  } else {
    print --stderr "✗ chat round-trip failed"
    exit 1
  }
}
