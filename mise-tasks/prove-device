#!/usr/bin/env nu
#MISE description="Prove the device daemon is connected — reads ~/.gsv/logs/node.log; works for pitchfork or launchd"

def main [] {
  let log_path = $"($env.HOME)/.gsv/logs/node.log"
  if not ($log_path | path exists) {
    print --stderr $"✗ no node log at ($log_path) — daemon never started?"
    exit 1
  }

  # The daemon emits multiple connect.ok events at the same ts (one with `implements`,
  # one with `keepaliveSeconds`). Merge all the latest-batch events into one record so
  # downstream field extraction picks up everything regardless of order.
  let all_connects = (
    open --raw $log_path
    | lines
    | where { |l| ($l | str contains 'connect.ok') }
    | each { |l| try { $l | from json } catch { null } }
    | where { |r| $r != null }
  )

  if ($all_connects | length) == 0 {
    print --stderr "✗ no connect.ok event in node.log — daemon hasn't connected yet"
    exit 1
  }

  let latest_ts = ($all_connects | last | get ts)
  let parsed = (
    $all_connects
    | where { |r| ($r.ts? | default "") == $latest_ts }
    | reduce {|it, acc| $acc | merge $it }
  )

  # Also check that no connect.fail / disconnect appeared after this connect.ok
  let later = (
    open --raw $log_path
    | lines
    | where { |l| ($l | str contains 'disconnect') or ($l | str contains 'connect.fail') }
    | where { |l|
        let evt = (try { $l | from json } catch { {ts: ""} })
        ($evt.ts? | default "") > ($parsed.ts? | default "")
      }
  )

  if ($later | length) > 0 {
    print --stderr $"✗ device disconnected after connect.ok at ($parsed.ts)"
    print --stderr ($later | last)
    exit 1
  }

  # url is on node.start, not connect.ok — pull from the most recent node.start event
  let url = (
    open --raw $log_path
    | lines
    | where { |l| ($l | str contains '"event":"node.start"') }
    | last
    | (try { from json | get url } catch { "?" })
  )
  let node_id = ($parsed.nodeId? | default "?")
  let workspace = ($parsed.workspace? | default "?")
  let impls = ($parsed.implements? | default [])
  print $"✓ device ($node_id) connected to ($url)"
  print $"  workspace: ($workspace)"
  print $"  implements: ($impls | str join ', ')"
}
