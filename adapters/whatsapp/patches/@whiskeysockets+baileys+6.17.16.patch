+    return typeof this.chainKey === 'string' ? Buffer.from(this.chainKey, 'base64') : this.chainKey;
+  }
+
+  getSignatureKey() {
+    return typeof this.signatureKey === 'string'
+      ? Buffer.from(this.signatureKey, 'base64')
+      : this.signatureKey;
+  }
+
+  getId() {
+    return this.id;
+  }
+}
